@page
@model IndexModel
@{
    ViewData["Title"] = "Air cargo, connected";
    var featuredProducts = Model.Products.Where(p => p.IsFeatured).OrderBy(p => p.SortOrder).Take(6).ToList();
}
<section class="hero ccn-hero">
    <div class="hero-grid"></div>
    <div class="hero-copy">
        <div class="eyebrow"><span class="eyebrow-line"></span> DIGITAL SOLUTIONS FOR AIR CARGO</div>
        <h1>Air cargo,<br /><em>connected.</em></h1>
        <p class="hero-desc">One connected cargo community for smarter bookings, smoother operations and more confident decisions.</p>
        <div class="hero-actions"><a class="button button-light" href="/#contact">Talk to our team <span>↗</span></a><a class="text-link" href="/products">Explore solutions <span>↓</span></a></div>
        <div class="hero-proof"><div class="proof-dots"><b>A</b><b>F</b><b>S</b></div><span>Connecting the air cargo ecosystem<br /><strong>across people, platforms and data</strong></span></div>
    </div>
    <div class="hero-art cargo-art" aria-hidden="true">
        <div class="art-ring ring-one"></div><div class="art-ring ring-two"></div><div class="art-ring ring-three"></div>
        <div class="art-core"><span>CCN</span><small>CARGO<br />COMMUNITY<br />NETWORK</small></div>
        <span class="orbit orbit-a">AIRLINES</span><span class="orbit orbit-b">FORWARDERS</span><span class="orbit orbit-c">CARGO DATA</span>
        <div class="art-note"><span class="note-star">✳</span><span>Connected for<br />what moves next.</span></div>
    </div>
    <div class="hero-bottom"><span>01 — 03</span><span class="scroll-line"></span><span>SCROLL TO EXPLORE</span></div>
</section>

<section class="intro section" id="about">
    <div class="section-label"><span>01</span> / THE CCN NETWORK</div>
    <div class="intro-content"><h2>Complex logistics.<br /><em>Clearer connections.</em></h2><div class="intro-text"><p>Cargo Community Network connects airlines, freight forwarders, ground handlers, shippers and authorities through digital services built for air cargo workflows.</p><p>From data exchange and cargo operations to customs compliance and payment, our goal is to make each handoff work better.</p><a class="under-link" href="https://www.ccn.com.sg/about-us/" target="_blank" rel="noopener">Learn about CCN <span>↗</span></a></div></div>
</section>

<section class="services section" id="solutions">
    <div class="section-label"><span>02</span> / SOLUTIONS</div>
    <div class="services-heading"><h2>Tools for every<br /><em>cargo workflow.</em></h2><p>Explore digital services for booking, compliance, visibility, operations and connected cargo payments.</p></div>
    <div class="service-grid product-grid">
        @foreach (var product in featuredProducts)
        {
            <article class="service-card product-card"><span class="service-index">@product.Category.ToUpperInvariant()</span><div class="service-icon">↗</div><h3>@product.Name</h3><p>@product.Summary</p><div class="product-audience">For @product.Audience</div><a href="@(product.Url ?? "/products")" aria-label="Learn more about @product.Name" target="@(product.Url?.StartsWith("http", StringComparison.OrdinalIgnoreCase) == true ? "_blank" : null)" rel="noopener">↗</a></article>
        }
    </div>
    <div class="catalog-cta"><span>Find the right service for your cargo operation.</span><a class="under-link" href="/products">Browse all solutions <span>↗</span></a></div>
</section>

<section class="ecosystem section" id="ecosystem">
    <div class="section-label"><span>03</span> / CONNECTED ECOSYSTEM</div>
    <div class="ecosystem-content"><div><h2>One network.<br /><em>More possibilities.</em></h2><p>CUBEforall is CCN's open data platform concept for connecting services, providers and cargo community users—helping the industry integrate and collaborate across workflows.</p><a class="button button-outline" href="https://www.cubeforall.com/" target="_blank" rel="noopener">Discover CUBEforall <span>↗</span></a></div><div class="ecosystem-nodes"><span class="node node-main">CARGO<br />COMMUNITY</span><span class="node node-airline">AIRLINES</span><span class="node node-forwarder">FORWARDERS</span><span class="node node-handler">GROUND<br />HANDLERS</span><span class="node node-shipper">SHIPPERS</span><span class="node node-customs">AUTHORITIES</span></div></div>
</section>

<section class="workflow section" id="workflow">
    <div class="section-label"><span>04</span> / BUILT AROUND CARGO</div>
    <div class="workflow-grid"><article><span>01 / CONNECT</span><h3>Move data between systems</h3><p>Support digital handoffs with data exchange, APIs, eFreight and electronic airway bill services.</p></article><article><span>02 / OPERATE</span><h3>Make cargo operations visible</h3><p>Coordinate bookings, rates, shipment status and operational milestones across partners.</p></article><article><span>03 / COMPLY</span><h3>Prepare for every requirement</h3><p>Support customs declarations, cargo screening, dangerous goods documentation and trade compliance processes.</p></article><article><span>04 / OPTIMIZE</span><h3>Improve service with insight</h3><p>Use dashboards, reporting and connected service data to identify delays and improve performance.</p></article></div>
</section>

<section class="contact section" id="contact">
    <div class="contact-aside"><div class="section-label"><span>05</span> / TALK TO CCN</div><h2>Let's move your<br />cargo goals <em>forward.</em></h2><p>Tell us about your business and the solution you're exploring. Our team will route your enquiry to the right people.</p><div class="contact-detail"><span class="detail-icon">✳</span><span>Headquartered in<br /><strong>Singapore · Serving the global cargo community</strong></span></div><a class="email-link" href="mailto:marketing@ccn.com.sg">marketing@ccn.com.sg <span>↗</span></a></div>
    <div class="contact-form-wrap">
        @if (Model.Sent) { <div class="form-success" role="status"><span>✓</span><div><strong>Thank you for contacting CCN.</strong><p>Your enquiry has been received. Our team will follow up with you.</p></div></div> }
        else {
        <form method="post" class="contact-form">
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <div class="form-row"><label asp-for="Input.Name">Full name <span>*</span><input asp-for="Input.Name" placeholder="Your name" autocomplete="name" /></label><label asp-for="Input.Company">Company <span>*</span><input asp-for="Input.Company" placeholder="Company name" autocomplete="organization" /></label></div>
            <div class="form-row"><label asp-for="Input.OrganizationType">I am a <span>*</span><select asp-for="Input.OrganizationType"><option value="">Select organization type</option><option>Airline</option><option>Freight forwarder</option><option>Ground handler</option><option>Shipper / trader</option><option>Customs / government authority</option><option>Technology / integration partner</option><option>Other</option></select></label><label asp-for="Input.Country">Country / region <span>*</span><input asp-for="Input.Country" placeholder="e.g. Singapore" autocomplete="country-name" /></label></div>
            <div class="form-row"><label asp-for="Input.Email">Business email <span>*</span><input asp-for="Input.Email" placeholder="name@company.com" autocomplete="email" /></label><label asp-for="Input.Phone">Phone number<input asp-for="Input.Phone" placeholder="+65 ..." autocomplete="tel" /></label></div>
            <label asp-for="Input.ProductInterest">Solution of interest <span>*</span><select asp-for="Input.ProductInterest"><option value="">Choose a solution or area</option>@foreach (var product in Model.Products) { <option value="@product.Name">@product.Name — @product.Category</option> }<option>Partnership / CUBEforall</option><option>General enquiry</option></select></label>
            <label asp-for="Input.Subject">Subject <span>*</span><input asp-for="Input.Subject" placeholder="How can we help your operation?" /></label>
            <label asp-for="Input.Message">Tell us more <span>*</span><textarea asp-for="Input.Message" rows="4" placeholder="Share the workflow, integration or cargo challenge you would like to discuss..."></textarea></label>
            <div class="visually-hidden" aria-hidden="true"><label asp-for="Website">Leave this field empty<input asp-for="Website" tabindex="-1" autocomplete="off" /></label></div>
            <button class="button button-dark" type="submit">Send enquiry <span>↗</span></button><small class="privacy-note">CCN will use these details to respond to your enquiry. Please do not include shipment or other confidential data in this form.</small>
        </form> }
    </div>
</section>
<div class="closing-strip"><span>CONNECTED CARGO</span><b>✳</b><span>BETTER DATA EXCHANGE</span><b>✳</b><span>SIMPLER WORKFLOWS</span></div>
